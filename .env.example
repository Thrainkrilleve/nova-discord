# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Your own Discord user ID (Developer Mode -> right-click yourself -> Copy User ID).
# The owner can use admin commands such as /listen and /status.
NOVA_OWNER_ID=

# OpenAI-compatible model server. llama-server's default is below.
# (The Docker stack ignores this and uses host.docker.internal)
NOVA_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Only needed if the server was started with --api-key
NOVA_LLM_API_KEY=

# Contact URL or email for Nova's web requests (Wikipedia refuses bots without one),
# e.g. your Forgejo or a throwaway address.
NOVA_CONTACT=

# Optional search providers (Nova falls back to DuckDuckGo without them)
# Google Programmable Search: https://programmablesearchengine.google.com (100 free queries/day)
NOVA_GOOGLE_API_KEY=
NOVA_GOOGLE_CX=
# Brave Search API: https://brave.com/search/api (free tier)
NOVA_BRAVE_API_KEY=

# aa-reporter API key (AA admin > Reporter > Api tokens), tied to a recruiter-level auth account
NOVA_AA_TOKEN=

# Key for Nova's chat-app API ([serve] in nova.toml). Required if [serve] host is not 127.0.0.1;
# chat apps send it as their "API key". Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVA_API_KEY=
# Other people's own keys for the chat-app API: discord_id:key,discord_id:key
# Each acts as that Discord user with their usual limits (no owner memory, no recruiter tools).
NOVA_API_USERS=

# Discord sign-in for the web app: the OAuth2 client secret of the application in [serve] discord_client_id
NOVA_DISCORD_CLIENT_SECRET=

# --- The Docker stack (deploy/docker-compose.yml) -------------------------------------------------
# Start it with: docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
# (--env-file matters: without it compose looks for deploy/.env and finds nothing)

# SearXNG signs its sessions with this. Any long random string:
#   openssl rand -hex 32
SEARXNG_SECRET=
# Port of nova-llm on the host (deploy/install-llm.sh); change both together
NOVA_LLM_PORT=8780
# Nova's container limits (optional)
NOVA_CPUS=4
NOVA_MEM=4g

# Channels where Nova may post, edit and pin her own messages for anyone who asks, without approval
# (channel IDs, comma-separated). Everywhere else her posts need a Root Privileges / Logi Bros click.
# See [admin] and [autonomy] in nova.toml.
NOVA_FREE_POST_CHANNELS=
